import { Injectable } from '@angular/core';
import { HttpClient, HttpHeaders } from '@angular/common/http';
import { Observable, throwError } from 'rxjs';
import { catchError } from 'rxjs/operators';

@Injectable({
  providedIn: 'root'
})
export class CourseServicesService {

  private apiUrl = 'YOUR_API_ENDPOINT_HERE'; // Replace with your actual API endpoint

  constructor(private http: HttpClient) { }

  getCourseWithCategoriesLob(lobId: string): Observable<any> {
    const url = `${this.apiUrl}/courses?lob_id=${lobId}`; // Adjust the URL as needed
    return this.http.get<any>(url)
      .pipe(
        catchError(this.handleError)
      );
  }

  // Example of a post request
  createCourse(courseData: any): Observable<any> {
    const url = `${this.apiUrl}/courses`;
    const httpOptions = {
      headers: new HttpHeaders({
        'Content-Type': 'application/json'
      })
    };
    return this.http.post<any>(url, courseData, httpOptions)
      .pipe(
        catchError(this.handleError)
      );
  }

  private handleError(error: any): Observable<any> {
    console.error('An error occurred', error);
    return throwError(() => new Error(error.message || 'Server error'));
  }
}
